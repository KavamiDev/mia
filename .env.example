# ──────────────────────────────────────
# MIA — Variables d'environnement
# ──────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer .env dans le dépôt git.

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://user:pass@localhost:5432/mia

# --- Sécurité API ---
# Protège les routes /restaurants, /menu, /reservations, /commandes.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
MIA_API_KEY=

# --- Sécurité Dashboard ---
# Mot de passe pour accéder au dashboard admin (/dashboard).
DASHBOARD_PASSWORD=ton-mot-de-passe-ici
# Secret pour signer les cookies de session (>= 32 caractères).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET=une-cle-secrete-random

# --- OpenAI (Realtime API) ---
OPENAI_API_KEY=sk-...

# --- Telnyx (téléphonie + SMS) ---
TELNYX_API_KEY=KEY...
TELNYX_PHONE_NUMBER=+33...

# --- Réseau ---
# URL publique du backend (pour le webhook Telnyx et le WebSocket média).
BACKEND_URL=https://xxx.ngrok-free.app

# --- Voix (optionnel) ---
# Voix OpenAI Realtime : coral, alloy, echo, fable, onyx, nova, shimmer
# VOICE_REALTIME_VOICE=coral
