# ──────────────────────────────────────
# MIA — Variables d'environnement
# ──────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer .env dans le dépôt git.

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://user:pass@localhost:5432/mia

# --- Sécurité API ---
# Protège les routes /restaurants, /menu, /reservations, /commandes.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
MIA_API_KEY=

# --- Sécurité Dashboard ---
# Mot de passe pour accéder au dashboard admin (/dashboard).
DASHBOARD_PASSWORD=ton-mot-de-passe-ici
# Secret pour signer les cookies de session (>= 32 caractères).
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET=une-cle-secrete-random

# --- OpenAI (Realtime API) ---
OPENAI_API_KEY=sk-...

# --- Telnyx (téléphonie + SMS hors zone +262) ---
TELNYX_API_KEY=KEY...
TELNYX_PHONE_NUMBER=+33...
# Clé publique Telnyx pour vérifier la signature Ed25519 des webhooks.
# À récupérer sur https://portal.telnyx.com (Account > Public Key).
TELNYX_PUBLIC_KEY=

# --- Brevo SMS (fallback pour +262 La Réunion / Mayotte) ---
# Telnyx ne livre pas de SMS vers les DOM Océan Indien. On bascule sur Brevo
# (ex-Sendinblue, FR) qui accepte les clients DOM et livre vers +262.
# Setup :
#   1. Compte sur https://app.brevo.com
#   2. Settings → API Keys → Create new key (v3)
#   3. Settings → Senders & IPs → ajouter un sender alphanumérique
#      (ex: "MIA") puis attendre validation (~24h pour la 1ère fois)
BREVO_API_KEY=xkeysib-...
# Sender ID alphanumérique (≤ 11 chars), affiché à la place du numéro
# expéditeur sur le téléphone du client. Doit être validé côté Brevo.
# BREVO_SENDER=MIA

# --- Réseau ---
# URL publique du backend (pour le webhook Telnyx et le WebSocket média).
BACKEND_URL=https://xxx.ngrok-free.app

# --- Voix (optionnel) ---
# Voix OpenAI Realtime : coral, alloy, echo, fable, onyx, nova, shimmer
# VOICE_REALTIME_VOICE=coral
# Modèle Realtime. OpenAI renomme régulièrement → variable pour switcher sans code.
#   gpt-realtime       : dernier stable (qualité max, ~0.30 $/min)
#   gpt-realtime-mini  : ~50% moins cher, qualité légèrement réduite
# OPENAI_REALTIME_MODEL=gpt-realtime
# Modèle de transcription (whisper-like). Aligner avec le Realtime ci-dessus.
#   gpt-4o-transcribe       : défaut (compatible gpt-realtime)
#   gpt-realtime-whisper    : modèle compagnon de gpt-realtime, à essayer si halluc.
#   whisper-1               : ancien stable, bonne base de fallback
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Observability (Sentry — recommandé en prod) ---
# DSN public depuis https://sentry.io/settings/projects/<project>/keys/
# SENTRY_DSN=https://abc123@o12345.ingest.sentry.io/67890

# --- Billing ---
# Tarif estimé par minute d'appel (OpenAI Realtime + Telnyx voice).
# Ajuster selon vos vrais coûts mesurés (frais cachés Telnyx, abonnement, etc.).
# BILLING_EUR_PER_MINUTE=0.40
# Seuil d'alerte mensuel par restaurant (logged + Sentry).
# BILLING_ALERT_EUR=100.0

# --- RGPD ---
# Durée de rétention des transcripts d'appel (jours).
# Au-delà, purge automatique via scripts/purge_old_calls.py (cron quotidien).
# RGPD_CALL_LOG_RETENTION_DAYS=30
